{
  "name": "tohoku-michinoeki-map",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "道の駅ナビ - 全国の道の駅を記録し、周辺の飲食店・観光・温泉を組み合わせたドライブコースを作れるルート検索PWA",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:official": "vite-node scripts/build-official.ts",
    "preview": "vite preview --host 0.0.0.0 --port 4173 --strictPort",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "npm run build && playwright test",
    "e2e:no-build": "playwright test",
    "gen-icons": "py -3 scripts/gen-icons.py"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.2",
    "@types/leaflet": "^1.9.14",
    "@types/leaflet.markercluster": "^1.5.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^0.20.5",
    "vitest": "^2.1.5"
  }
}
